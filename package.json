{
  "name": "dsh-agent-prompts",
  "version": "0.7.0",
  "type": "module",
  "description": "DeepSeek Harness 技能包：10 个按场景自动加载的技能（全栈单体/微服务 × 开发/排查 + 阿里 Java/前端规约 + Spring Boot + Vue 3 + 前端视觉设计 + 软件工程流程自动选择），带章节渐进披露、P0 红线扫描、设计反模式检查与提交前门禁；技术版本跟随项目，不硬绑。",
  "main": "lib/index.js",
  "bin": {
    "dsh-agent-prompts-scan": "./resources/scan-redlines.mjs",
    "dsh-agent-prompts-design": "./resources/frontend-design/check-design.mjs"
  },
  "files": [
    "lib",
    "skills",
    "resources",
    "docs",
    "AGENTS.md",
    "agent.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "NOTICE.md",
    "PUBLISH.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./scan": "./resources/scan-redlines.mjs",
    "./design-check": "./resources/frontend-design/check-design.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check resources/scan-redlines.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test",
    "scan:java": "node resources/scan-redlines.mjs --profile java",
    "scan:frontend": "node resources/scan-redlines.mjs --profile frontend",
    "check:design": "node resources/frontend-design/check-design.mjs --root . --fail-on P1",
    "prepublishOnly": "npm run verify"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "skill",
    "prompt",
    "fullstack",
    "spring-boot",
    "spring-cloud",
    "spring-modulith",
    "vue3",
    "vue-router",
    "pinia",
    "vueuse",
    "frontend-design",
    "design-system",
    "code-review",
    "alibaba-java",
    "f2e-spec",
    "coding-standards",
    "software-engineering",
    "sdlc",
    "agile",
    "scrum",
    "kanban",
    "devops",
    "eslint",
    "p0-redlines"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lw24-1936/dsh-agent-prompts.git"
  },
  "bugs": {
    "url": "https://github.com/lw24-1936/dsh-agent-prompts/issues"
  },
  "homepage": "https://github.com/lw24-1936/dsh-agent-prompts#readme",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
